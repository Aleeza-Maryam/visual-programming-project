                    <div class="card-footer bg-transparent border-0 pb-4 px-4">
                        <a href="#" class="btn btn-outline-primary w-100">
                            <i class="fas fa-info-circle"></i> Learn More
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Skardu -->
            <div class="col-md-4">
                <div class="card destination-card h-100 shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="position-relative">
                       <img src="/images/destinations/skardu.jpg" class="card-img-top" style="height: 250px; width: 100%; object-fit: cover;" alt="Skardu">
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                <i class="fas fa-star text-warning"></i> 4.9
                            </span>
