@using AITourismPlanner.ViewModels
@using System.Linq
@model HomeViewModel
@{
    ViewData["Title"] = "TravelMate - Your AI Travel Companion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section with Video Background -->
<section class="hero-section position-relative" style="height: 100vh; overflow: hidden;">
    <!-- Video Background -->
    <video autoplay muted loop playsinline id="heroVideo" style="position: absolute; top: 50%; left: 50%; min-width: 100%; min-height: 100%; width: auto; height: auto; transform: translate(-50%, -50%); object-fit: cover;">
        <source src="/videos/hero-travel.mp4" type="video/mp4">
        <!-- Fallback image if video doesn't load -->
    </video>
    <!-- Dark Overlay -->
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(0,0,0,0.55);"></div>
    
    <!-- Content -->
    <div class="container h-100 d-flex align-items-center position-relative" style="z-index: 1;">
        <div class="text-center text-white w-100">
            <h1 class="display-1 fw-bold animate__animated animate__fadeInDown">TravelMate</h1>
            <p class="lead fs-3 mt-3 animate__animated animate__fadeInUp">Explore Pakistan Like Never Before</p>
            <p class="fs-5 mt-2 animate__animated animate__fadeInUp animate__delay-1s">Your AI-Powered Travel Companion</p>
            <div class="mt-5 animate__animated animate__fadeInUp animate__delay-2s">
                <a href="@Url.Action("Index", "Destination")" class="btn btn-primary btn-lg mx-2 px-4 py-3">
                    <i class="fas fa-search"></i> Explore Destinations
                </a>
                <a href="@Url.Action("PlanTrip", "Trips")" class="btn btn-outline-light btn-lg mx-2 px-4 py-3">
                    <i class="fas fa-robot"></i> AI Trip Planner
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Stats Counter Section -->
<section class="stats-section py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row text-center text-white g-4">
            <div class="col-md-3">
                <div class="counter-box">
                    <i class="fas fa-map-marked-alt fa-3x mb-3"></i>
                    <h2 class="counter fw-bold display-4" data-target="50">0</h2>
                    <p class="fs-5">Destinations</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="counter-box">
                    <i class="fas fa-users fa-3x mb-3"></i>
                    <h2 class="counter fw-bold display-4" data-target="10000">0</h2>
                    <p class="fs-5">Happy Travelers</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="counter-box">
                    <i class="fas fa-hotel fa-3x mb-3"></i>
                    <h2 class="counter fw-bold display-4" data-target="500">0</h2>
                    <p class="fs-5">Hotels</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="counter-box">
                    <i class="fas fa-star fa-3x mb-3"></i>
                    <h2 class="counter fw-bold display-4" data-target="4.8" data-decimal="1">0.0</h2>
                    <p class="fs-5">Average Rating</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Search Bar Section -->
<section class="search-section py-4 bg-white shadow-sm">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <form asp-action="Search" asp-controller="Destinations" method="get" class="row g-2">
                    <div class="col-md-4">
                        <input type="text" name="searchTerm" class="form-control form-control-lg" placeholder="Where to?">
                    </div>
                    <div class="col-md-3">
                        <select name="category" class="form-select form-select-lg">
                            <option value="">All Categories</option>
                            @if (Model.Categories != null && Model.Categories.Any())
                            {
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.category_name">@cat.category_name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="number" name="budget" class="form-control form-control-lg" placeholder="Max Budget (PKR)">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Popular Destinations -->
<section class="destinations-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">Popular Destinations</h2>
            <p class="lead text-muted">Discover the most loved places by our travelers</p>
        </div>
        <div class="row g-4">
            @if (Model.PopularDestinations != null && Model.PopularDestinations.Any())
            {
                @foreach (var dest in Model.PopularDestinations)
                {
                    <div class="col-md-4 col-lg-4">
                        <div class="card destination-card h-100 shadow-lg border-0 rounded-4 overflow-hidden">
                            <div class="position-relative">
                                @{
                                    var imagePath = dest.thumbnail;
                                    if (string.IsNullOrEmpty(imagePath) || !imagePath.StartsWith("/images/"))
                                    {
                                        if (!string.IsNullOrEmpty(dest.name))
                                        {
                                            var nameLower = dest.name.ToLower();
                                            if (nameLower.Contains("hunza")) imagePath = "/images/hunza.jpg";
                                            else if (nameLower.Contains("murree")) imagePath = "/images/murree.jpg";
                                            else if (nameLower.Contains("skardu")) imagePath = "/images/skardu.jpg";
                                            else if (nameLower.Contains("swat")) imagePath = "/images/swat.jpg";
                                            else if (nameLower.Contains("naran")) imagePath = "/images/naran.jpg";
                                            else imagePath = "/images/default-destination.jpg";
                                        }
                                        else
                                        {
                                            imagePath = "/images/default-destination.jpg";
                                        }
                                    }
                                }
                                <img src="@imagePath" 
                                     class="card-img-top" 
                                     style="height: 250px; width: 100%; object-fit: cover;" 
                                     alt="@dest.name"
                                     onerror="this.onerror=null; this.src='/images/default-destination.jpg';">
                                <div class="position-absolute top-0 end-0 m-3">
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                        <i class="fas fa-star text-warning"></i> @dest.rating_average.ToString("0.0")
                                    </span>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <h5 class="card-title fw-bold">@dest.name</h5>
                                <p class="card-text text-muted">@(dest.description?.Length > 100 ? dest.description.Substring(0, 100) + "..." : dest.description)</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-primary fw-bold fs-5">PKR @dest.estimated_cost?.ToString("N0")</span>
                                    <span class="text-muted"><i class="fas fa-map-marker-alt"></i> @(dest.city ?? "Pakistan")</span>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 pb-4 px-4">
                                <a href="@Url.Action("Details", "Destinations", new { id = dest.destination_id })" class="btn btn-outline-primary w-100">
                                    View Details <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle fa-2x mb-2"></i>
                        <h4>No destinations found</h4>
                        <p>Please add destinations to your database.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- AI Trip Planner CTA -->
<section class="ai-section py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-7 text-white">
                <h2 class="display-4 fw-bold">Plan Your Trip with AI</h2>
                <p class="fs-4 mt-3">Tell us your budget, preferences, and let our AI suggest the perfect destination and itinerary for you.</p>
                <ul class="list-unstyled mt-4">
                    <li><i class="fas fa-check-circle me-2"></i> Smart destination recommendations</li>
                    <li><i class="fas fa-check-circle me-2"></i> Day-wise itinerary generator</li>
                    <li><i class="fas fa-check-circle me-2"></i> Budget optimization</li>
                    <li><i class="fas fa-check-circle me-2"></i> Real-time weather updates</li>
                </ul>
                <a href="@Url.Action("PlanTrip", "Trips")" class="btn btn-light btn-lg mt-4 px-5 py-3 fw-bold">
                    <i class="fas fa-magic"></i> Start AI Planning
                </a>
            </div>
            <div class="col-md-5 text-center">
                <img src="/images/ai-illustration.svg" alt="AI Planning" class="img-fluid" style="max-height: 350px;" onerror="this.style.display='none'">
            </div>
        </div>
    </div>
</section>

<!-- Featured Hotels -->
<section class="hotels-section py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">Featured Hotels</h2>
            <p class="lead text-muted">Handpicked accommodations for you</p>
        </div>
        <div class="row g-4">
            @if (Model.FeaturedHotels != null && Model.FeaturedHotels.Any())
            {
                @foreach (var hotel in Model.FeaturedHotels)
                {
                    <div class="col-md-3 col-sm-6">
                        <div class="card hotel-card shadow-sm border-0 rounded-4 h-100">
                            @{
                                var hotelImage = hotel.image;
                                if (string.IsNullOrEmpty(hotelImage))
                                {
                                    hotelImage = "/images/hotel-default.jpg";
                                }
                            }
                            <img src="@hotelImage" 
                                 class="card-img-top rounded-top-4" 
                                 style="height: 180px; width: 100%; object-fit: cover;" 
                                 alt="@hotel.hotel_name"
                                 onerror="this.onerror=null; this.src='/images/hotel-default.jpg';">
                            <div class="card-body p-3">
                                <h6 class="card-title fw-bold">@hotel.hotel_name</h6>
                                <div class="mb-2">
                                    @for (int i = 1; i <= (hotel.star_rating ?? 0); i++)
                                    {
                                        <i class="fas fa-star text-warning small"></i>
                                    }
                                </div>
                                <p class="text-primary fw-bold">PKR @hotel.price_per_night?.ToString("N0")<span class="text-muted fw-normal">/night</span></p>
                                <a href="@Url.Action("Details", "Hotels", new { id = hotel.hotel_id })" class="btn btn-sm btn-outline-primary w-100">View Hotel</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- User Reviews Slider Section -->
<section class="reviews-slider-section py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">❤️ What Our Travelers Say</h2>
            <p class="lead text-muted">Real reviews from real travelers</p>
        </div>
        
        @if (Model.UserReviews != null && Model.UserReviews.Any())
        {
            <div id="reviewsCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @{
                        var reviewGroups = Model.UserReviews.Chunk(3).ToList();
                        for (int i = 0; i < reviewGroups.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <div class="row g-4">
                                    @foreach (var review in reviewGroups[i])
                                    {
                                        <div class="col-md-4">
                                            <div class="card testimonial-card h-100 shadow-sm border-0 rounded-4">
                                                <div class="card-body p-4">
                                                    <div class="mb-3">
                                                        @for (int s = 1; s <= review.Rating; s++)
                                                        {
                                                            <i class="fas fa-star text-warning"></i>
                                                        }
                                                        @for (int s = review.Rating + 1; s <= 5; s++)
                                                        {
                                                            <i class="far fa-star text-muted"></i>
                                                        }
                                                    </div>
                                                    <p class="card-text">"@(review.Comment.Length > 120 ? review.Comment.Substring(0, 120) + "..." : review.Comment)"</p>
                                                    <div class="d-flex align-items-center mt-3">
                                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                                            <span class="fw-bold">@(review.UserName.FirstOrDefault().ToString())</span>
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-0 fw-bold">@review.UserName</h6>
                                                            <small class="text-muted">Visited @review.DestinationName</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#reviewsCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon bg-dark rounded-circle" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#reviewsCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon bg-dark rounded-circle" aria-hidden="true"></span>
                </button>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-comment-dots fa-3x text-muted mb-3"></i>
                <p>No reviews yet. Be the first to review!</p>
            </div>
        }
    </div>
</section>

<!-- Newsletter Section -->
<section class="newsletter-section py-5" style="background: #0a192f;">
    <div class="container text-center text-white">
        <h3 class="fw-bold">Subscribe to Our Newsletter</h3>
        <p class="mb-4">Get exclusive travel deals and AI planning tips</p>
        <div class="row justify-content-center">
            <div class="col-md-6">
                <form id="newsletterForm" class="input-group">
                    <input type="email" id="newsletterEmail" class="form-control form-control-lg" placeholder="Your email address" required>
                    <button class="btn btn-primary btn-lg" type="submit">
                        <i class="fas fa-paper-plane"></i> Subscribe
                    </button>
                </form>
                <div id="newsletterMessage" class="mt-3"></div>
            </div>
        </div>
    </div>
</section>

<style>
    .destination-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .destination-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
    }
    .testimonial-card {
        transition: all 0.3s ease;
    }
    .testimonial-card:hover {
        transform: scale(1.02);
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }
    .search-section {
        margin-top: -30px;
        position: relative;
        z-index: 1000;
    }
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }
    .btn-primary:hover {
        background: linear-gradient(135deg, #5a67d8 0%, #6b46a0 100%);
        transform: translateY(-2px);
    }
    img {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
    }
    .card-img-top {
        min-height: 250px;
        background-color: #f0f0f0;
    }
    .hero-section {
        position: relative;
    }
    .z-1 {
        z-index: 1;
    }
    #heroVideo {
        object-fit: cover;
    }
    @@media (max-width: 768px) {
    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/hero-bg.jpg');
        background-size: cover;
        background-position: center;
    }
    #heroVideo {
        display: none;
    }
}
</style>

@section Scripts {
<script>
    // Newsletter Subscription
    $('#newsletterForm').on('submit', function(e) {
        e.preventDefault();
        var email = $('#newsletterEmail').val();
        
        $.ajax({
            url: '@Url.Action("SubscribeNewsletter", "Home")',
            type: 'POST',
            data: { email: email },
            success: function(response) {
                if (response.success) {
                    $('#newsletterMessage').html('<div class="alert alert-success">' + response.message + '</div>');
                    $('#newsletterEmail').val('');
                } else {
                    $('#newsletterMessage').html('<div class="alert alert-danger">' + response.message + '</div>');
                }
                setTimeout(function() {
                    $('#newsletterMessage').html('');
                }, 3000);
            }
        });
    });

    // Counter Animation
    function isElementInViewport(el) {
        var rect = el.getBoundingClientRect();
        var buffer = 100;
        return rect.top <= (window.innerHeight + buffer) && rect.bottom >= 0;
    }
    
    function animateCounter(element, start, end, duration, isDecimal) {
        var startTime = null;
        
        function updateCounter(currentTime) {
            if (startTime === null) startTime = currentTime;
            var progress = Math.min(1, (currentTime - startTime) / duration);
            var value = start + (end - start) * progress;
            
            if (isDecimal) {
                element.innerText = value.toFixed(1);
            } else {
                element.innerText = Math.floor(value).toLocaleString();
            }
            
            if (progress < 1) {
                requestAnimationFrame(updateCounter);
            } else {
                element.innerText = isDecimal ? end.toFixed(1) : end.toLocaleString();
            }
        }
        
        requestAnimationFrame(updateCounter);
    }
    
    var countersAnimated = false;
    
    $(window).on('scroll', function() {
        var counters = $('.counter');
        var statsSection = $('.stats-section');
        
        if (statsSection.length && isElementInViewport(statsSection[0]) && !countersAnimated) {
            countersAnimated = true;
            counters.each(function() {
                var target = parseFloat($(this).attr('data-target'));
                var isDecimal = $(this).attr('data-decimal') === '1';
                var start = isDecimal ? 0 : 0;
                var end = target;
                animateCounter(this, start, end, 2000, isDecimal);
            });
        }
    });
    
    // Trigger on page load if already visible
    $(document).ready(function() {
        var counters = $('.counter');
        var statsSection = $('.stats-section');
        if (statsSection.length && isElementInViewport(statsSection[0])) {
            countersAnimated = true;
            counters.each(function() {
                var target = parseFloat($(this).attr('data-target'));
                var isDecimal = $(this).attr('data-decimal') === '1';
                var end = target;
                if (isDecimal) {
                    $(this).text(end.toFixed(1));
                } else {
                    $(this).text(end.toLocaleString());
                }
            });
        }
    });
</script>
}