<!-- User Reviews Auto-Slider Section -->
<section class="reviews-slider-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">❤️ What Our Travelers Say</h2>
            <p class="lead text-muted">Real reviews from real travelers</p>
        </div>
        
        @if (Model.UserReviews != null && Model.UserReviews.Any())
        {
            <div id="reviewsCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @{
                        var reviewGroups = Model.UserReviews.Chunk(3).ToList();
                        for (int i = 0; i < reviewGroups.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <div class="row g-4">
                                    @foreach (var review in reviewGroups[i])
                                    {
                                        <div class="col-md-4">
                                            <div class="card testimonial-card h-100 shadow-sm border-0 rounded-4">
                                                <div class="card-body p-4">
                                                    <div class="mb-3">
                                                        @for (int s = 1; s <= review.Rating; s++)
                                                        {
                                                            <i class="fas fa-star text-warning"></i>
                                                        }
                                                        @for (int s = review.Rating + 1; s <= 5; s++)
                                                        {
                                                            <i class="far fa-star text-muted"></i>
                                                        }
                                                    </div>
                                                    <p class="card-text fs-5">"@(review.Comment.Length > 150 ? review.Comment.Substring(0, 150) + "..." : review.Comment)"</p>
                                                    <div class="d-flex align-items-center mt-4">
                                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                                            <span class="fw-bold fs-5">@(review.UserName.FirstOrDefault().ToString())</span>
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-0 fw-bold">@review.UserName</h6>
                                                            <small class="text-muted">Visited @review.DestinationName</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-comment-dots fa-3x text-muted mb-3"></i>
                <p>No reviews yet. Be the first to review!</p>
            </div>
        }
    </div>
</section>

<style>
    .destination-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }
    .destination-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
    }
    .testimonial-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }
    .testimonial-card:hover {
        transform: scale(1.02);
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }
    .hotel-card {
        transition: transform 0.3s ease;
        cursor: pointer;
    }
    .hotel-card:hover {
        transform: translateY(-5px);
    }
    .search-section {
        margin-top: -30px;
        position: relative;
        z-index: 1000;
    }
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }
    .btn-primary:hover {
        background: linear-gradient(135deg, #5a67d8 0%, #6b46a0 100%);
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(102,126,234,0.4);
    }
    .hero-section {
        position: relative;
    }
    .counter-plus {
        font-size: 2rem;
        margin-left: 5px;
    }
    @@media (max-width: 768px) {
        .display-1 {
            font-size: 2.5rem;
        }
        .display-4 {
            font-size: 2rem;
        }
        .display-5 {
            font-size: 1.8rem;
        }
        .counter-plus {
            font-size: 1.2rem;
        }
        #heroVideo {
            display: none;
        }
        .hero-section {
            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1587925358603-c2eea5305bbc?w=1200');
            background-size: cover;
            background-position: center;
        }
    }
</style>

@section Scripts {
    <script type="text/javascript">
        // Counter Animation
        function isElementInViewport(el) {
            var rect = el.getBoundingClientRect();
            var buffer = 100;
            return rect.top <= (window.innerHeight + buffer) && rect.bottom >= 0;
        }
        
        function animateCounter(element, start, end, duration, isDecimal) {
            var startTime = null;
            
            function updateCounter(currentTime) {
                if (startTime === null) startTime = currentTime;
                var progress = Math.min(1, (currentTime - startTime) / duration);
                var value = start + (end - start) * progress;
                
                var numberText = isDecimal ? value.toFixed(1) : Math.floor(value).toLocaleString();
                element.childNodes[0].nodeValue = numberText;
                
                if (progress < 1) {
                    requestAnimationFrame(updateCounter);
                } else {
                    element.childNodes[0].nodeValue = isDecimal ? end.toFixed(1) : end.toLocaleString();
                }
            }
            requestAnimationFrame(updateCounter);
        }
        
        var countersAnimated = false;
        
        window.addEventListener('scroll', function() {
            var counters = document.querySelectorAll('.counter');
            var statsSection = document.querySelector('.stats-section');
            
            if (statsSection && isElementInViewport(statsSection) && !countersAnimated) {
                countersAnimated = true;
                counters.forEach(function(counter) {
                    var target = parseFloat(counter.getAttribute('data-target'));
                    var isDecimal = counter.getAttribute('data-decimal') === '1';
                    animateCounter(counter, 0, target, 2000, isDecimal);
                });
            }
        });
        
        document.addEventListener('DOMContentLoaded', function() {
            var counters = document.querySelectorAll('.counter');
            var statsSection = document.querySelector('.stats-section');
            if (statsSection && isElementInViewport(statsSection)) {
                countersAnimated = true;
                counters.forEach(function(counter) {
                    var target = parseFloat(counter.getAttribute('data-target'));
                    var isDecimal = counter.getAttribute('data-decimal') === '1';
                    if (isDecimal) {
                        counter.childNodes[0].nodeValue = target.toFixed(1);
                    } else {
                        counter.childNodes[0].nodeValue = target.toLocaleString();
                    }
                });
            }
        });
    </script>
}