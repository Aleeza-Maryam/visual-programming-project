@using AITourismPlanner.ViewModels
@using System.Linq
@model HomeViewModel
@{
    ViewData["Title"] = "TravelMate - Your AI Travel Companion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section with Video Background -->
<section class="hero-section position-relative" style="height: 100vh; overflow: hidden;">
    <video autoplay muted loop playsinline id="heroVideo" style="position: absolute; top: 50%; left: 50%; min-width: 100%; min-height: 100%; width: auto; height: auto; transform: translate(-50%, -50%); object-fit: cover;">
        <source src="/videos/hero-travel.mp4" type="video/mp4">
    </video>
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(0,0,0,0.55);"></div>
    
    <div class="container h-100 d-flex align-items-center position-relative" style="z-index: 1;">
        <div class="text-center text-white w-100">
            <h1 class="display-1 fw-bold animate__animated animate__fadeInDown">TravelMate</h1>
            <p class="lead fs-3 mt-3 animate__animated animate__fadeInUp">Explore Pakistan Like Never Before</p>
            <p class="fs-5 mt-2 animate__animated animate__fadeInUp animate__delay-1s">Your AI-Powered Travel Companion</p>
            <div class="mt-5 animate__animated animate__fadeInUp animate__delay-2s">
                <a href="@Url.Action("Index", "Destinations")" class="btn btn-primary btn-lg mx-2 px-4 py-3">
                    <i class="fas fa-search"></i> Explore Destinations
                </a>
                <a href="@Url.Action("PlanTrip", "Trips")" class="btn btn-outline-light btn-lg mx-2 px-4 py-3">
                    <i class="fas fa-robot"></i> AI Trip Planner
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Stats Counter Section -->
<section class="stats-section py-5" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
    <div class="container">
        <div class="row text-center text-white g-4">
            <div class="col-md-3">
                <div class="counter-box">
                    <i class="fas fa-map-marked-alt fa-3x mb-3"></i>
                    <h2 class="counter fw-bold display-4" data-target="50">0<span class="counter-plus">+</span></h2>
                    <p class="fs-5 mb-0">Destinations</p>
                    <small class="opacity-75">Across Pakistan</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="counter-box">
                    <i class="fas fa-users fa-3x mb-3"></i>
                    <h2 class="counter fw-bold display-4" data-target="10000">0<span class="counter-plus">+</span></h2>
                    <p class="fs-5 mb-0">Happy Travelers</p>
                    <small class="opacity-75">And growing</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="counter-box">
                    <i class="fas fa-hotel fa-3x mb-3"></i>
                    <h2 class="counter fw-bold display-4" data-target="500">0<span class="counter-plus">+</span></h2>
                    <p class="fs-5 mb-0">Hotels</p>
                    <small class="opacity-75">Best accommodations</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="counter-box">
                    <i class="fas fa-star fa-3x mb-3"></i>
                    <h2 class="counter fw-bold display-4" data-target="4.8" data-decimal="1">0.0<span class="counter-plus">★</span></h2>
                    <p class="fs-5 mb-0">Average Rating</p>
                    <small class="opacity-75">From verified guests</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Search Bar Section -->
<section class="search-section py-4 bg-white shadow-sm">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <form asp-action="Search" asp-controller="Destinations" method="get" class="row g-2">
                    <div class="col-md-4">
                        <input type="text" name="searchTerm" class="form-control form-control-lg" placeholder="Where to?">
                    </div>
                    <div class="col-md-3">
                        <select name="category" class="form-select form-select-lg">
                            <option value="">All Categories</option>
                            @if (Model.Categories != null && Model.Categories.Any())
                            {
                                foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.category_name">@cat.category_name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="number" name="budget" class="form-control form-control-lg" placeholder="Max Budget (PKR)">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

