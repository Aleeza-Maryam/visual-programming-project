@model List<AITourismPlanner.Models.DestinationReview>
@{
    ViewData["Title"] = "Manage Reviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-star text-primary me-2"></i>Manage Reviews</h2>
        <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>User</th>
                            <th>Destination</th>
                            <th>Rating</th>
                            <th>Review</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var review in Model)
                        {
                            <tr>
                                <td>@review.review_id</td>
                                <td>@(review.User?.full_name ?? "Anonymous")</td>
                                <td>@review.destination_name</td>
                                <td>
                                    <div class="text-warning">
                                        @for (int i = 1; i <= (review.rating ?? 0); i++)
                                        {
                                            <i class="fas fa-star small"></i>
                                        }
                                        @for (int i = (review.rating ?? 0) + 1; i <= 5; i++)
                                        {
                                            <i class="far fa-star small"></i>
                                        }
                                    </div>
                                </td>
                                <td>@(review.comment?.Length > 50 ? review.comment.Substring(0, 50) + "..." : review.comment)</td>
                                <td>@review.created_at.ToString("dd MMM yyyy")</td>
                                <td>
                                    <button class="btn btn-danger btn-sm" onclick="deleteReview(@review.review_id)">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-star fa-4x text-muted mb-3"></i>
                    <h5>No reviews found</h5>
                    <p class="text-muted">Reviews will appear here when users submit them.</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function deleteReview(id) {
        if (confirm("Are you sure you want to delete this review?")) {
            fetch('@Url.Action("DeleteReview", "Admin")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${id}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) location.reload();
                else alert("Failed to delete review");
            });
        }
    }
</script>