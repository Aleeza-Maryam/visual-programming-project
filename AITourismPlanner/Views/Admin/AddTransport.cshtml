@model AITourismPlanner.Models.Transport
@{
    ViewData["Title"] = "Add Transport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4">
                    <h4 class="fw-bold"><i class="fas fa-plus text-primary me-2"></i>Add New Transport</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="AddTransport" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="transport_type" class="form-label">Transport Type</label>
                                <select asp-for="transport_type" class="form-select" required>
                                    <option value="Bus">Bus</option>
                                    <option value="Train">Train</option>
                                    <option value="Flight">Flight</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="company_name" class="form-label">Company Name</label>
                                <input asp-for="company_name" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="departure_city" class="form-label">Departure City</label>
                                <input asp-for="departure_city" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="arrival_city" class="form-label">Arrival City</label>
                                <input asp-for="arrival_city" class="form-control" required>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="departure_time" class="form-label">Departure Time</label>
                                <input asp-for="departure_time" type="time" class="form-control" required>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="duration" class="form-label">Duration</label>
                                <input asp-for="duration" class="form-control" placeholder="2 hours">
                            </div>
                            <div class="col-md-3">
                                <label asp-for="fare" class="form-label">Fare (PKR)</label>
                                <input asp-for="fare" type="number" class="form-control" required>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="available_seats" class="form-label">Available Seats</label>
                                <input asp-for="available_seats" type="number" class="form-control" value="40">
                            </div>
                           
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary px-4">Save Transport</button>
                            <a href="@Url.Action("Transport", "Admin")" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>