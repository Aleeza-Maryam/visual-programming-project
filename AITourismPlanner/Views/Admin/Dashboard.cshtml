@model AITourismPlanner.Controllers.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var adminName = ViewBag.AdminName ?? "Admin";
}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<div class="container-fluid py-4">
    <!-- Welcome Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-gradient-primary text-white border-0 rounded-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body p-4">
                    <h1 class="display-5 fw-bold">
                        <i class="fas fa-crown me-2"></i> Welcome, @adminName!
                    </h1>
                    <p class="mb-0">Here's what's happening with your platform today.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted">Total Users</h6>
                            <h2 class="fw-bold">@Model.TotalUsers</h2>
                            <small>@Model.TotalCustomers Customers</small>
                        </div>
                        <i class="fas fa-users fa-3x text-primary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- Revenue Charts Section -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4">
                        <h5 class="fw-bold mb-0">
                            <i class="fas fa-chart-bar text-primary me-2"></i> Monthly Revenue (Bar Chart)
                        </h5>
                    </div>
                    <div class="card-body">
                        <canvas id="revenueBarChart" style="height: 300px; width: 100%;"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4">
                        <h5 class="fw-bold mb-0">
                            <i class="fas fa-chart-line text-primary me-2"></i> Revenue Trend (Line Chart)
                        </h5>
                    </div>
                    <div class="card-body">
                        <canvas id="revenueLineChart" style="height: 300px; width: 100%;"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted">Total Bookings</h6>
                            <h2 class="fw-bold">@Model.TotalBookings</h2>
                            <small class="text-warning">@Model.PendingBookings Pending</small>
                        </div>
                        <i class="fas fa-hotel fa-3x text-primary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted">Destinations</h6>
                            <h2 class="fw-bold">@Model.TotalDestinations</h2>
                            <small>+@Model.TotalHotels Hotels</small>
                        </div>
                        <i class="fas fa-map-marked-alt fa-3x text-primary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted">Total Revenue</h6>
                            <h2 class="fw-bold fs-4">PKR @Model.TotalRevenue.ToString("N0")</h2>
                        </div>
                        <i class="fas fa-rupee-sign fa-3x text-primary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Bookings Table -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-4">
            <h5 class="fw-bold mb-0"><i class="fas fa-clock text-primary me-2"></i>Recent Bookings</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Destination</th>
                            <th>Check In</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.RecentBookings)
                        {
                            <tr>
                                <td>@(booking.User?.full_name ?? "N/A")</td>
                                <td>@booking.destination_name</td>
                                <td>@booking.check_in_date.ToString("dd MMM")</td>
                                <td>PKR @booking.total_price?.ToString("N0")</td>
                                <td>
                                    <span class="badge @(booking.booking_status == "Confirmed" ? "bg-success" : booking.booking_status == "Pending" ? "bg-warning" : "bg-danger")">
                                        @booking.booking_status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <!-- Quick Actions -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4">
            <h5 class="fw-bold mb-0"><i class="fas fa-bolt text-primary me-2"></i>Quick Actions</h5>
        </div>
        <div class="card-body">
            <div class="d-flex gap-3 flex-wrap">
                <a href="@Url.Action("Users", "Admin")" class="btn btn-primary">
                    <i class="fas fa-users me-2"></i>Manage Users
                </a>
                <a href="@Url.Action("Bookings", "Admin")" class="btn btn-success">
                    <i class="fas fa-hotel me-2"></i>Manage Bookings
                </a>
                <a href="@Url.Action("Packages", "Admin")" class="btn btn-info">
                    <i class="fas fa-box me-2"></i>Manage Packages
                </a>
                <a href="@Url.Action("Transport", "Admin")" class="btn btn-warning">
                    <i class="fas fa-bus me-2"></i>Manage Transport
                </a>
                <a href="@Url.Action("Reviews", "Admin")" class="btn btn-dark">
                    <i class="fas fa-star me-2"></i>Manage Reviews
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
</style>