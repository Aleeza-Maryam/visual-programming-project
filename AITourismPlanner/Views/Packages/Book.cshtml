@model AITourismPlanner.Controllers.PackageBookingViewModel
@{
    ViewData["Title"] = "Book Package";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userId = Context.Session.GetInt32("UserId");
    var userName = Context.Session.GetString("UserName");
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Packages")">Packages</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", "Packages", new { id = Model.Package?.package_id })">@Model.Package?.package_name</a></li>
            <li class="breadcrumb-item active">Book Now</li>
        </ol>
    </nav>

    <div class="alert alert-success mb-4" id="discountBanner" style="display: none;">
        <i class="fas fa-gift me-2"></i>
        <strong>✨ Special Offer!</strong> Get <strong>@(Model.Package?.group_discount_percent)% discount</strong> when booking for <strong>4 or more people</strong>!
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-4">Complete Your Booking</h2>

                    <div class="card bg-light border-0 rounded-4 mb-4">
                        <div class="card-body p-3">
                            <h6 class="fw-bold mb-2" id="pkgNameDisplay">@Model.Package?.package_name</h6>
                            <p class="text-muted small mb-1"><i class="fas fa-map-marker-alt me-1"></i> @Model.Package?.destination_name</p>
                            <p class="text-muted small mb-0"><i class="fas fa-clock me-1"></i> @Model.Package?.duration_days Days / @Model.Package?.duration_nights Nights</p>
                            <p class="text-primary fw-bold mt-2 mb-0">PKR @Model.Package?.price_per_person.ToString("N0") <span class="text-muted fw-normal">/person</span></p>
                        </div>
                    </div>

                    <input type="hidden" id="packageId" value="@Model.Package?.package_id">
                    <input type="hidden" id="pricePerPerson" value="@Model.Package?.price_per_person">
                    <input type="hidden" id="discountPercent" value="@Model.Package?.group_discount_percent">
                    <input type="hidden" id="packageDescription" value="Includes @Model.Package?.duration_days Days stay at @Model.Package?.destination_name. Room Preference and Dietary needs compiled via AI engine.">

                    <div class="mb-3">
                        <label class="form-label fw-bold">Travel Date</label>
                        <input type="date" id="travelDate" class="form-control" min="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")">
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Adults (12+ years)</label>
                            <input type="number" id="numberOfAdults" class="form-control" min="1" max="10" value="1" onchange="calculateTotal()">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Children (Under 12)</label>
                            <input type="number" id="numberOfChildren" class="form-control" min="0" max="10" value="0" onchange="calculateTotal()">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Special Requests (Optional)</label>
                        <textarea id="specialRequests" class="form-control" rows="2" placeholder="Any special requests? Dietary needs, room preferences, etc."></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Dietary Needs</label>
                            <select id="dietaryNeeds" class="form-select">
                                <option value="">None</option>
                                <option value="Vegetarian">Vegetarian</option>
                                <option value="Vegan">Vegan</option>
                                <option value="Halal">Halal</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Room Preference</label>
                            <select id="roomPreferences" class="form-select">
                                <option value="">Standard</option>
                                <option value="Double Bed">Double Bed</option>
                                <option value="Twin Beds">Twin Beds</option>
                                <option value="Family Room">Family Room</option>
                            </select>
                        </div>
                    </div>

                    <div class="card bg-light border-0 rounded-4 mb-4">
                        <div class="card-body p-3">
                            <h6 class="fw-bold mb-3">Guest Information</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Full Name</label>
                                    <input type="text" id="guestName" class="form-control" value="@userName" placeholder="Your full name">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Contact Number</label>
                                    <input type="tel" id="guestPhone" class="form-control" placeholder="03XXXXXXXXX">
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Email Address</label>
                                    <input type="email" id="guestEmail" class="form-control" placeholder="your@email.com">
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="button" id="btnConfirmBookingMain" class="btn btn-primary w-100 py-3 fw-bold btn-lg shadow-sm" onclick="confirmBooking()">
                        <i class="fas fa-check-circle me-2"></i>Confirm Booking & Receive PDF
                    </button>
                </div>
            </div>

            @if (Model.Package != null)
            {
                <div class="card border-0 shadow-sm rounded-4 mt-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="fas fa-cloud-sun text-primary me-2"></i>Weather Info for @Model.Package.destination_name</h5>
                        <div id="weatherInfo" class="text-center py-3">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading weather...</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 mt-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="fas fa-map text-primary me-2"></i>Location Map</h5>
                    <div id="packageMap" style="height: 300px; border-radius: 12px;"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 position-sticky" style="top: 20px;">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Price Summary</h4>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Package Price</span>
                        <span class="fw-bold">PKR @Model.Package?.price_per_person.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Adults</span>
                        <span id="adultsCountDisplay">1</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Children</span>
                        <span id="childrenCountDisplay">0</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span id="subtotal">PKR 0</span>
                    </div>

                    <div id="discountRow" style="display:none;" class="bg-success bg-opacity-10 p-2 rounded-2 my-2">
                        <div class="d-flex justify-content-between mb-0 text-success">
                            <span><i class="fas fa-tags me-1"></i> Group Discount (@Model.Package?.group_discount_percent%)</span>
                            <span id="discountAmount">- PKR 0</span>
                        </div>
                    </div>

                    <hr>
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total Price</span>
                        <span class="text-primary" id="totalPrice">PKR 0</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="successModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 text-center">
            <div class="modal-body p-5">
                <i class="fas fa-check-circle fa-5x text-success mb-3"></i>
                <h3 class="fw-bold">Booking Confirmed! 🎉</h3>
                <p class="text-muted">An automated itinerary PDF invoice has been sent to your email address.</p>
                <p class="text-muted small">Your booking reference sequence is:</p>
                <h4 class="text-primary fw-bold mb-4" id="bookingRef"></h4>

                <div class="d-grid gap-2">
                    <a href="@Url.Action("DownloadVoucher", "Packages", new { reference = "" })" class="btn btn-success" id="downloadVoucherBtn">
                        <i class="fas fa-download me-2"></i>Download Voucher Offline
                    </a>
                    <a href="@Url.Action("MyPackageBookings", "Packages")" class="btn btn-outline-primary">
                        View My Complete Bookings
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

@section Scripts {
    <script>
        var map = null;
        var pricePerPerson = parseFloat('@Model.Package?.price_per_person'.replace(/,/g, '')) || 0;
        var discountPercent = parseFloat('@Model.Package?.group_discount_percent') || 0;
        var destinationName = '@Model.Package?.destination_name';

        // Placeholder function to maintain structured runtime calls
        async function loadWeather() {
        var weatherDiv = document.getElementById('weatherInfo');
        if(weatherDiv) {
        weatherDiv.innerHTML = `<i class="fas fa-sun text-warning fa-2x mb-2"></i><p class="mb-0">Clear Skies Ideal for Expeditions (24°C)</p>`;
        }
        }

        // Load map integration layer
        async function loadMap() {
        try {
        var response = await fetch(`https://nominatim.openstreetmap.org/search?q=${destinationName},Pakistan&format=json&limit=1`);
        var data = await response.json();
        if (data && data.length > 0) {
        var lat = parseFloat(data[0].lat);
        var lon = parseFloat(data[0].lon);
        map = L.map('packageMap').setView([lat, lon], 10);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
        }).addTo(map);
        L.marker([lat, lon]).addTo(map).bindPopup(destinationName).openPopup();
        setTimeout(function() { map.invalidateSize(); }, 200);
        } else {
        document.getElementById('packageMap').innerHTML = '<div class="alert alert-warning">Map track point layer unavailable</div>';
        }
        } catch (error) {
        document.getElementById('packageMap').innerHTML = '<div class="alert alert-warning">Map component initialization fallback</div>';
        }
        }

        function calculateTotal() {
        var adults = parseInt(document.getElementById('numberOfAdults').value) || 0;
        var children = parseInt(document.getElementById('numberOfChildren').value) || 0;
        var totalPersons = adults + children;

        document.getElementById('adultsCountDisplay').innerText = adults;
        document.getElementById('childrenCountDisplay').innerText = children;

        var subtotal = pricePerPerson * totalPersons;
        var discount = 0;
        var discountBanner = document.getElementById('discountBanner');
        var discountRow = document.getElementById('discountRow');

        if (totalPersons >= 4 && discountPercent > 0) {
        discount = subtotal * (discountPercent / 100);
        discountBanner.style.display = 'block';
        discountRow.style.display = 'block';
        document.getElementById('discountAmount').innerHTML = '- PKR ' + discount.toLocaleString();

        discountRow.style.backgroundColor = '#d4edda';
        setTimeout(() => { discountRow.style.backgroundColor = ''; }, 500);
        } else {
        discountBanner.style.display = 'none';
        discountRow.style.display = 'none';
        }

        var total = subtotal - discount;
        document.getElementById('subtotal').innerText = 'PKR ' + subtotal.toLocaleString();
        document.getElementById('totalPrice').innerText = 'PKR ' + total.toLocaleString();
        return total;
        }

        function confirmBooking() {
        var guestName = document.getElementById('guestName').value;
        var guestPhone = document.getElementById('guestPhone').value;
        var guestEmail = document.getElementById('guestEmail').value;
        var travelDate = document.getElementById('travelDate').value;
        var adults = document.getElementById('numberOfAdults').value;
        var children = document.getElementById('numberOfChildren').value;
        var pkgName = document.getElementById('pkgNameDisplay').innerText;
        var pkgDesc = document.getElementById('packageDescription').value;

        if (!guestName) { alert('Please enter your name'); return; }
        if (!guestPhone) { alert('Please enter contact number'); return; }
        if (!guestEmail) { alert('Please enter email address'); return; }
        if (!travelDate) { alert('Please select travel date'); return; }

        var totalPriceFormatted = document.getElementById('totalPrice').innerText;
        var totalPriceRaw = calculateTotal();

        // Loading state handler
        var mainBtn = document.getElementById('btnConfirmBookingMain');
        var originalBtnText = mainBtn.innerHTML;
        mainBtn.disabled = true;
        mainBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status"></span> Generating Secure PDF & Booking...`;

        var formData = new URLSearchParams();
        formData.append('packageId', document.getElementById('packageId').value);
        formData.append('travelDate', travelDate);
        formData.append('numberOfAdults', adults);
        formData.append('numberOfChildren', children);
        formData.append('specialRequests', document.getElementById('specialRequests').value);
        formData.append('dietaryNeeds', document.getElementById('dietaryNeeds').value);
        formData.append('roomPreferences', document.getElementById('roomPreferences').value);
        formData.append('guestName', guestName);
        formData.append('guestPhone', guestPhone);
        formData.append('guestEmail', guestEmail);
        formData.append('totalPrice', totalPriceRaw);

        // Step A: Save Booking to DB
        fetch('@Url.Action("CreatePackageBooking", "Packages")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: formData.toString()
        })
        .then(response => response.json())
        .then(data => {
        if (data.success) {
        // Step B: Database successfully updated, proceed to silent Email PDF relay background process
        fetch('@Url.Action("SendPackagePdf", "Trips")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({
        customerEmail: guestEmail,
        customerName: guestName,
        packageName: pkgName,
        price: totalPriceFormatted,
        description: pkgDesc
        }).toString()
        })
        .then(() => {
        // Reset button state and trigger UI Modal regardless of email handshake exceptions
        mainBtn.disabled = false;
        mainBtn.innerHTML = originalBtnText;

        document.getElementById('bookingRef').innerText = data.reference;
        document.getElementById('downloadVoucherBtn').href = '@Url.Action("DownloadVoucher", "Packages")?reference=' + data.reference;
        var successModal = new bootstrap.Modal(document.getElementById('successModal'));
        successModal.show();
        });
        } else {
        mainBtn.disabled = false;
        mainBtn.innerHTML = originalBtnText;
        alert(data.message || 'Booking structure failed. Please verify credentials.');
        }
        })
        .catch(error => {
        console.error('Error:', error);
        mainBtn.disabled = false;
        mainBtn.innerHTML = originalBtnText;
        alert('An orchestration error surface point occurred.');
        });
        }

        // Initialize runtime triggers
        calculateTotal();
        loadWeather();
        loadMap();
    </script>
}