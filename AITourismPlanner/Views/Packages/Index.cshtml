@model List<AITourismPlanner.Models.Package>
@{
    ViewData["Title"] = "Tour Packages";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">✨ Tour Packages</h1>
        <p class="lead">Choose the perfect package for your dream vacation</p>
    </div>

    <!-- ========================================================= -->
    <!-- AI BUDGET COMPARISON TOOL -->
    <!-- ========================================================= -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">
                <i class="fas fa-chart-line text-primary"></i> AI Budget Comparison
            </h5>
            <div class="row g-3">
                <div class="col-md-5">
                    <select id="compareDest1" class="form-select">
                        <option value="">Select Destination 1</option>
                        @if (ViewBag.DestinationsList != null)
                        {
                            foreach (var dest in ViewBag.DestinationsList as List<string> ?? new List<string>())
                            {
                                <option value="@dest">@dest</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <select id="compareDest2" class="form-select">
                        <option value="">Select Destination 2</option>
                        @if (ViewBag.DestinationsList != null)
                        {
                            foreach (var dest in ViewBag.DestinationsList as List<string> ?? new List<string>())
                            {
                                <option value="@dest">@dest</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" onclick="compareBudget()">
                        <i class="fas fa-chart-simple me-1"></i> Compare
                    </button>
                </div>
            </div>
            <div id="comparisonResult" class="mt-3" style="display: none;"></div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-8">
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="?type=all&sort=@ViewBag.SelectedSort" class="btn @(ViewBag.SelectedType == "all" ? "btn-primary" : "btn-outline-secondary")">All</a>
                        <a href="?type=Budget&sort=@ViewBag.SelectedSort" class="btn @(ViewBag.SelectedType == "Budget" ? "btn-primary" : "btn-outline-secondary")">💰 Budget</a>
                        <a href="?type=Standard&sort=@ViewBag.SelectedSort" class="btn @(ViewBag.SelectedType == "Standard" ? "btn-primary" : "btn-outline-secondary")">⭐ Standard</a>
                        <a href="?type=Premium&sort=@ViewBag.SelectedSort" class="btn @(ViewBag.SelectedType == "Premium" ? "btn-primary" : "btn-outline-secondary")">👑 Premium</a>
                        <a href="?type=Honeymoon&sort=@ViewBag.SelectedSort" class="btn @(ViewBag.SelectedType == "Honeymoon" ? "btn-primary" : "btn-outline-secondary")">💕 Honeymoon</a>
                        <a href="?type=Family&sort=@ViewBag.SelectedSort" class="btn @(ViewBag.SelectedType == "Family" ? "btn-primary" : "btn-outline-secondary")">👨‍👩‍👧‍👦 Family</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select" id="sortSelect">
                        <option value="price_asc">Price: Low to High</option>
                        <option value="price_desc">Price: High to Low</option>
                        <option value="duration_asc">Duration: Short to Long</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Packages Grid -->
    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var pkg in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card package-card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="position-relative">
                            <img src="@pkg.cover_image" style="height:200px; width:100%; object-fit:cover;" alt="@pkg.package_name" onerror="this.src='https://images.unsplash.com/photo-1586500036706-41963de24d8b?w=600'">
                            <span class="position-absolute top-0 end-0 m-3 badge @(pkg.package_type == "Budget" ? "bg-success" : pkg.package_type == "Premium" ? "bg-danger" : "bg-primary") p-2">
                                @pkg.package_type
                            </span>
                        </div>
                        <div class="card-body p-4">
                            <h5 class="fw-bold">@pkg.package_name</h5>
                            <p class="text-muted small"><i class="fas fa-map-marker-alt me-1"></i>@pkg.destination_name</p>

                            <div class="d-flex justify-content-between mb-2">
                                <span><i class="fas fa-clock me-1"></i>@pkg.duration_days Days / @pkg.duration_nights Nights</span>
                                <span><i class="fas fa-hotel me-1"></i>@(pkg.hotel_stars)⭐ Hotel</span>
                            </div>

                            <div class="d-flex justify-content-between mb-2">
                                <span><i class="fas fa-bus me-1"></i>@pkg.transport_type</span>
                                <span><i class="fas fa-utensils me-1"></i>@pkg.meals_included</span>
                            </div>

                            @if (pkg.group_discount_percent > 0)
                            {
                                <span class="badge bg-info text-dark mb-2"><i class="fas fa-users"></i> @pkg.group_discount_percent% off for 4+ people</span>
                            }

                            <div class="mt-3">
                                <span class="text-primary fw-bold fs-4">PKR @pkg.price_per_person.ToString("N0")</span>
                                <span class="text-muted">/person</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-4 px-4">
                            <a href="@Url.Action("Details", new { id = pkg.package_id })" class="btn btn-primary w-100">View Details →</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-box fa-4x text-muted mb-3"></i>
            <h3>No packages found</h3>
            <p class="text-muted">Check back later for exciting tour packages!</p>
        </div>
    }
</div>

<style>
    .package-card {
        transition: transform 0.3s ease;
    }

        .package-card:hover {
            transform: translateY(-5px);
        }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }
</style>

<script>
    // Set selected option based on current sort
    var sortParam = '@ViewBag.SelectedSort';
    if (sortParam && document.getElementById('sortSelect')) {
        document.getElementById('sortSelect').value = sortParam;
    }

    // On change, reload page with new sort
    var sortSelect = document.getElementById('sortSelect');
    if (sortSelect) {
        sortSelect.addEventListener('change', function() {
            window.location.href = '?type=@ViewBag.SelectedType&sort=' + this.value;
        });
    }

    // =========================================================
    // AI BUDGET COMPARISON FUNCTION
    // =========================================================
    async function compareBudget() {
        var dest1 = document.getElementById('compareDest1').value;
        var dest2 = document.getElementById('compareDest2').value;
        var resultDiv = document.getElementById('comparisonResult');

        if (!dest1 || !dest2) {
            alert('Please select both destinations');
            return;
        }

        resultDiv.style.display = 'block';
        resultDiv.innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"></div><p>AI is comparing budgets...</p></div>';

        try {
            var response = await fetch('/api/ai/compare-budget?dest1=' + encodeURIComponent(dest1) + '&dest2=' + encodeURIComponent(dest2) + '&days=3');
            var data = await response.json();

            var savings = Math.abs(data.cost1 - data.cost2);

            resultDiv.innerHTML = `
                <div class="alert alert-info">
                    <div class="row text-center">
                        <div class="col-6">
                            <h5>${data.destination1}</h5>
                            <p class="text-primary fw-bold fs-3">PKR ${data.cost1.toLocaleString()}</p>
                        </div>
                        <div class="col-6">
                            <h5>${data.destination2}</h5>
                            <p class="text-primary fw-bold fs-3">PKR ${data.cost2.toLocaleString()}</p>
                        </div>
                    </div>
                    <hr>
                    <div class="text-center">
                        <strong class="text-success">AI Recommendation:</strong> ${data.recommendation} is cheaper by PKR ${savings.toLocaleString()}!
                    </div>
                </div>
            `;
        } catch (error) {
            console.error('Budget comparison error:', error);
            resultDiv.innerHTML = '<div class="alert alert-danger">Failed to compare. Please try again.</div>';
        }
    }
</script>