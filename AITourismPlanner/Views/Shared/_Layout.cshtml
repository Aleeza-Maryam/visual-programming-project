<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TravelMate</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />

    <style>
            * {
                font-family: 'Poppins', sans-serif;
            }

            body {
                overflow-x: hidden;
            }

            .navbar {
                background: white;
                box-shadow: 0 2px 20px rgba(0,0,0,0.1);
                padding: 0.8rem 0;
                transition: all 0.3s ease;
            }

            .navbar-scrolled {
                background: rgba(255,255,255,0.95) !important;
                backdrop-filter: blur(10px);
                box-shadow: 0 5px 30px rgba(0,0,0,0.1);
            }

            .nav-link {
                font-weight: 500;
                color: #333 !important;
                transition: all 0.3s ease;
                margin: 0 0.3rem;
                padding: 0.5rem 0.8rem;
                font-size: 0.95rem;
            }

                .nav-link:hover {
                    color: #667eea !important;
                    transform: translateY(-2px);
                }

            .dropdown-menu {
                border: none;
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
                border-radius: 15px;
                padding: 0.5rem 0;
            }

            .dropdown-item {
                padding: 0.5rem 1.2rem;
                transition: all 0.3s ease;
                font-size: 0.9rem;
            }

                .dropdown-item:hover {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    color: white;
                    transform: translateX(5px);
                }

            .footer {
                background: #0a192f;
                color: white;
                padding: 4rem 0 2rem;
            }

                .footer a {
                    color: #aaa;
                    text-decoration: none;
                    transition: all 0.3s ease;
                }

                    .footer a:hover {
                        color: #667eea;
                        transform: translateX(5px);
                    }

            .btn-gradient {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                border: none;
                transition: all 0.3s ease;
                padding: 0.4rem 1rem;
                font-size: 0.9rem;
            }

                .btn-gradient:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 5px 20px rgba(102,126,234,0.4);
                    color: white;
                }

            .toast-notification {
                position: fixed;
                bottom: 20px;
                right: 20px;
                z-index: 9999;
            }

            /* Custom Scrollbar */
            ::-webkit-scrollbar {
                width: 10px;
            }

            ::-webkit-scrollbar-track {
                background: #f1f1f1;
            }

            ::-webkit-scrollbar-thumb {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #5a67d8;
                }

            main {
                margin-top: 70px;
                min-height: calc(100vh - 70px);
            }

            /* Admin Dropdown Header */
            .admin-dropdown-header {
                padding: 8px 15px;
                font-size: 12px;
                font-weight: bold;
                color: #667eea;
                background: #f8f9fa;
            }

            /* --- Fix Sign Up button wrapping and text overlap --- */
            .btn-gradient, .navbar-nav .btn {
                white-space: nowrap !important;
                display: inline-flex !important;
                align-items: center;
                justify-content: center;
            }

            /* --- Adaptive layout adjustments for multi-item navbar --- */
            @@media (min-width: 992px) and (max-width: 1300px) {
                .nav-link {
                    font-size: 0.82rem !important;
                    padding: 0.4rem 0.45rem !important;
                }

                .navbar-brand span {
                    font-size: 1.3rem !important;
                }

                .navbar .btn {
                    padding: 5px 12px !important;
                    font-size: 0.82rem !important;
                }
            }

            @@media (max-width: 991px) {
                .navbar {
                    padding: 0.5rem 0;
                }

                .navbar-nav {
                    padding: 10px 0;
                }

                .nav-link {
                    padding: 0.5rem 1rem;
                    margin: 0;
                }

                .dropdown-menu {
                    border: none;
                    box-shadow: none;
                    background: transparent;
                    padding-left: 20px;
                }

                .dropdown-item:hover {
                    transform: none;
                }

                .btn-gradient {
                    margin-top: 5px;
                    width: 100%;
                    text-align: center;
                }
            }

            @@media (max-width: 768px) {
                .navbar-brand {
                    font-size: 1.3rem;
                }

                .nav-link {
                    font-size: 0.85rem;
                    padding: 0.4rem 0.8rem;
                }

                main {
                    margin-top: 65px;
                }
            }

            /* AI Chatbot Styles */
            .chatbot-button {
                position: fixed;
                bottom: 30px;
                right: 30px;
                width: 60px;
                height: 60px;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                box-shadow: 0 4px 15px rgba(0,0,0,0.2);
                z-index: 999;
                transition: transform 0.3s ease;
            }

                .chatbot-button:hover {
                    transform: scale(1.1);
                }

                .chatbot-button i {
                    color: white;
                }

            .chatbot-modal {
                position: fixed;
                bottom: 100px;
                right: 30px;
                width: 350px;
                height: 500px;
                background: white;
                border-radius: 15px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.2);
                z-index: 1000;
                display: none;
                flex-direction: column;
                overflow: hidden;
                border: 1px solid #eee;
            }

            .chatbot-header {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                padding: 15px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-weight: bold;
            }

            .chatbot-close {
                background: none;
                border: none;
                color: white;
                font-size: 24px;
                cursor: pointer;
            }

            .chatbot-messages {
                flex: 1;
                padding: 15px;
                overflow-y: auto;
                background: #f8f9fa;
            }

            .bot-message, .user-message {
                display: flex;
                margin-bottom: 15px;
            }

            .bot-message {
                justify-content: flex-start;
            }

            .user-message {
                justify-content: flex-end;
            }

            .message-bubble {
                max-width: 80%;
                padding: 10px 15px;
                border-radius: 18px;
                font-size: 14px;
            }

            .bot-message .message-bubble {
                background: white;
                color: #333;
                border: 1px solid #eee;
            }

            .user-message .message-bubble {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
            }

            .chatbot-input {
                display: flex;
                padding: 15px;
                background: white;
                border-top: 1px solid #eee;
            }

                .chatbot-input input {
                    flex: 1;
                    padding: 10px;
                    border: 1px solid #ddd;
                    border-radius: 25px;
                    outline: none;
                }

                .chatbot-input button {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    border: none;
                    color: white;
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    margin-left: 10px;
                    cursor: pointer;
                }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg fixed-top" id="mainNav">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3" href="@Url.Action("Index", "Home")" style="text-decoration: none;">
                <i class="fas fa-map-marked-alt me-2" style="color: #667eea; transition: transform 0.3s ease;"></i>
                <span style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">TravelMate</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">
                            <i class="fas fa-home"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Destinations")">
                            <i class="fas fa-map-marked-alt"></i> Destinations
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Weather")">
                            <i class="fas fa-cloud-sun"></i> Weather
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Transport")">
                            <i class="fas fa-bus"></i> Transport
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Packages")">
                            <i class="fas fa-box"></i> Packages
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Search", "RealHotels")">
                            <i class="fas fa-globe"></i> Real Hotels
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("About", "Home")">
                            <i class="fas fa-info-circle"></i> About
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    @{
                        var userId = Context.Session.GetInt32("UserId");
                        var userName = Context.Session.GetString("UserName");
                        var userRole = Context.Session.GetString("UserRole");
                    }
                    @if (userId.HasValue)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle"></i> @userName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Dashboard", "Account")">
                                        <i class="fas fa-tachometer-alt"></i> Dashboard
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("MyBookings", "Bookings")">
                                        <i class="fas fa-ticket-alt"></i> My Bookings
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Wishlist", "Account")">
                                        <i class="fas fa-heart"></i> Wishlist
                                    </a>
                                </li>

                                @if (userRole == "Admin")
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="admin-dropdown-header">
                                        <i class="fas fa-crown me-2"></i> Admin Panel
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Dashboard", "Admin")">
                                            <i class="fas fa-chart-line"></i> Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Packages", "Admin")">
                                            <i class="fas fa-box"></i> Manage Packages
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Transport", "Admin")">
                                            <i class="fas fa-bus"></i> Manage Transport
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Users", "Admin")">
                                            <i class="fas fa-users"></i> Manage Users
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Bookings", "Admin")">
                                            <i class="fas fa-hotel"></i> Manage Bookings
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Reviews", "Admin")">
                                            <i class="fas fa-star"></i> Manage Reviews
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                                        <i class="fas fa-sign-out-alt"></i> Logout
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Account")">
                                <i class="fas fa-sign-in-alt"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary ms-2" href="@Url.Action("Register", "Account")" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 8px; padding: 6px 18px;">
                                <i class="fas fa-user-plus me-1"></i> Sign Up
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h4 class="fw-bold mb-3"><i class="fas fa-map-marked-alt text-primary"></i> TravelMate</h4>
                    <p>Plan your perfect trip using artificial intelligence. Get personalized recommendations, smart itineraries, and best deals.</p>
                    <div class="mt-3">
                        <a href="#" class="me-3"><i class="fab fa-facebook fa-lg"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-twitter fa-lg"></i></a>
                        <a href="#" class="me-3"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="#"><i class="fab fa-linkedin fa-lg"></i></a>
                    </div>
                </div>
                <div class="col-md-2 mb-4">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li><a href="@Url.Action("Index", "Destinations")">Destinations</a></li>
                        <li><a href="@Url.Action("PlanTrip", "Trips")">AI Planner</a></li>
                        <li><a href="@Url.Action("Index", "Weather")">Weather</a></li>
                        <li><a href="@Url.Action("Search", "Transport")">Transport</a></li>
                        <li><a href="@Url.Action("Search", "RealHotels")">Real Hotels</a></li>
                        <li><a href="@Url.Action("About", "Home")">About Us</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h5>Support</h5>
                    <ul class="list-unstyled">
                        <li><a href="#">Help Center</a></li>
                        <li><a href="#">Terms & Conditions</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="@Url.Action("Contact", "Home")">Contact Us</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h5>Contact Info</h5>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-phone me-2"></i> +92 300 1234567</li>
                        <li><i class="fas fa-envelope me-2"></i> info@travelmate.com</li>
                        <li><i class="fas fa-map-marker-alt me-2"></i> Islamabad, Pakistan</li>
                    </ul>
                </div>
            </div>
            <hr class="mt-4">
            <div class="text-center">
                <p class="mb-0">&copy; 2025 TravelMate. All rights reserved. Powered by Artificial Intelligence.</p>
            </div>
        </div>
    </footer>

    <div id="chatbotBtn" class="chatbot-button" onclick="toggleChatbot()">
        <i class="fas fa-robot fa-2x"></i>
    </div>

    <div id="chatbotModal" class="chatbot-modal">
        <div class="chatbot-header">
            <div>
                <i class="fas fa-robot me-2"></i>
                <span>AI Travel Assistant</span>
            </div>
            <button class="chatbot-close" onclick="toggleChatbot()">&times;</button>
        </div>
        <div class="chatbot-messages" id="chatMessages">
            <div class="bot-message">
                <div class="message-bubble">Hello! I'm your AI travel assistant. Ask me anything about Pakistan travel! 🇵🇰</div>
            </div>
        </div>
        <div class="chatbot-input">
            <input type="text" id="chatInput" placeholder="Ask me something..." onkeypress="if(event.keyCode==13) sendMessage()">
            <button onclick="sendMessage()"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

    <script>
        // Navbar scroll effect
        window.addEventListener('scroll', function() {
        var nav = document.getElementById('mainNav');
        if (window.scrollY > 50) {
        nav.classList.add('navbar-scrolled');
        } else {
        nav.classList.remove('navbar-scrolled');
        }
        });

        // Brand icon hover animation
        var brandLink = document.querySelector('.navbar-brand');
        if (brandLink) {
        brandLink.addEventListener('mouseenter', function() {
        this.querySelector('i').style.transform = 'rotate(-5deg) scale(1.1)';
        });
        brandLink.addEventListener('mouseleave', function() {
        this.querySelector('i').style.transform = 'rotate(0deg) scale(1)';
        });
        }

        // AI Chatbot Functions
        function toggleChatbot() {
        var modal = document.getElementById('chatbotModal');
        modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
        }

        async function sendMessage() {
        var input = document.getElementById('chatInput');
        var message = input.value.trim();
        if (!message) return;

        var messagesDiv = document.getElementById('chatMessages');

        messagesDiv.innerHTML += '<div class="user-message"><div class="message-bubble">' + escapeHtml(message) + '</div></div>';
        input.value = '';
        messagesDiv.scrollTop = messagesDiv.scrollHeight;

        messagesDiv.innerHTML += '<div class="bot-message" id="typingIndicator"><div class="message-bubble">Typing...</div></div>';
        messagesDiv.scrollTop = messagesDiv.scrollHeight;

        try {
        var response = await fetch('/api/ai/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(message)
        });
        var data = await response.json();
        var typingIndicator = document.getElementById('typingIndicator');
        if (typingIndicator) typingIndicator.remove();
        messagesDiv.innerHTML += '<div class="bot-message"><div class="message-bubble">' + escapeHtml(data.answer) + '</div></div>';
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
        } catch (error) {
        var typingIndicator = document.getElementById('typingIndicator');
        if (typingIndicator) typingIndicator.remove();
        messagesDiv.innerHTML += '<div class="bot-message"><div class="message-bubble">Sorry, I encountered an error. Please try again.</div></div>';
        }
        }

        function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>