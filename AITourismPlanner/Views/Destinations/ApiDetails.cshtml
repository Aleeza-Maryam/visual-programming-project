@model AITourismPlanner.ViewModels.ApiDestinationViewModel
@{
    ViewData["Title"] = Model.CityName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userId = Context.Session.GetInt32("UserId");
    var userName = Context.Session.GetString("UserName");
}

<div class="container-fluid p-0">

    <!-- Hero Section -->
    <div class="hero-section position-relative"
         style="height:300px;
        background: linear-gradient(rgba(0,0,0,0.5),rgba(0,0,0,0.5)),
        url('@(Model.DestinationInfo?.ImageUrl ??
                             "https://images.unsplash.com/photo-1586500036706-41963de24d8b?w=1200")')
        center/cover no-repeat;">
        <div class="container h-100 d-flex align-items-center">
            <div class="text-white">
                <h1 class="display-4 fw-bold">@Model.CityName</h1>
                <p class="fs-5"><i class="fas fa-map-marker-alt me-2"></i>Pakistan</p>
                @if (Model.CurrentWeather != null)
                {
                    <div class="bg-white bg-opacity-25 rounded-pill px-3 py-1 d-inline-block">
                        <img src="@Model.CurrentWeather.Icon" style="width:25px;">
                        <span>@Model.CurrentWeather.Temperature.ToString("0")°C</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="container py-4">

        <!-- Tabs -->
        <ul class="nav nav-pills mb-4 gap-2" id="destTabs">
            <li class="nav-item"><button class="nav-link active btn-sm px-4" data-bs-toggle="pill" data-bs-target="#hotels"><i class="fas fa-hotel me-1"></i> Hotels</button></li>
            <li class="nav-item"><button class="nav-link btn-sm px-4" data-bs-toggle="pill" data-bs-target="#weather"><i class="fas fa-cloud-sun me-1"></i> Weather</button></li>
            <li class="nav-item"><button class="nav-link btn-sm px-4" data-bs-toggle="pill" data-bs-target="#transport"><i class="fas fa-bus me-1"></i> Transport</button></li>
            <li class="nav-item"><button class="nav-link btn-sm px-4" data-bs-toggle="pill" data-bs-target="#map"><i class="fas fa-map me-1"></i> Map</button></li>
            <li class="nav-item"><button class="nav-link btn-sm px-4" data-bs-toggle="pill" data-bs-target="#reviews"><i class="fas fa-star me-1"></i> Reviews</button></li>
        </ul>

        <div class="tab-content">

            <!-- ========================================================= -->
            <!-- STEP 1: HOTELS TAB -->
            <!-- ========================================================= -->
            <div class="tab-pane fade show active" id="hotels">
                <h3 class="fw-bold mb-4"><i class="fas fa-hotel text-primary me-2"></i>Step 1: Select Hotel (Optional)</h3>

                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle me-2"></i>
                    You can either select a hotel OR click "Skip Hotels" if you only need transport.
                </div>

                @if (Model.NearbyHotels.Any())
                {
                    <div class="row g-4" id="hotelsGrid">
                        @foreach (var hotel in Model.NearbyHotels.Take(6))
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card hotel-card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                                    <img src="@(!string.IsNullOrEmpty(hotel.ImageUrl) ? hotel.ImageUrl : "https://images.unsplash.com/photo-1566073771259-6a8506099945?w=400")"
                                         style="height:160px; object-fit:cover;" alt="@hotel.Name">
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold mb-1">@hotel.Name</h6>
                                        <p class="text-muted small mb-2"><i class="fas fa-map-marker-alt me-1"></i>@hotel.Address</p>
                                        @if (hotel.Rating.HasValue)
                                        {
                                            <span class="badge bg-success mb-2"><i class="fas fa-star me-1"></i>@hotel.Rating?.ToString("0.0")</span>
                                        }
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-primary fw-bold fs-5">PKR @hotel.PricePerNight?.ToString("N0")<span class="text-muted fw-normal fs-6">/night</span></span>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent border-0 pb-3 px-3">
                                        <button class="btn btn-primary w-100 btn-sm" onclick="selectHotel('@hotel.Name.Replace("'", "\\'")', @(hotel.PricePerNight ?? 0))">
                                            <i class="fas fa-calendar-check me-1"></i> Select & Continue
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Skip Hotels Option -->
                <div class="text-center mt-4 pt-3 border-top">
                    <button class="btn btn-outline-secondary btn-lg px-5" onclick="skipHotels()">
                        <i class="fas fa-skip me-2"></i> Skip Hotels / No Hotel Needed
                    </button>
                </div>
            </div>

            <!-- ========================================================= -->
            <!-- WEATHER TAB -->
            <!-- ========================================================= -->
            <div class="tab-pane fade" id="weather">
                <h3 class="fw-bold mb-4"><i class="fas fa-cloud-sun text-primary me-2"></i>Weather in @Model.CityName</h3>

                @if (Model.CurrentWeather != null)
                {
                    <div class="card border-0 rounded-4 mb-4 text-white" style="background:linear-gradient(135deg,#4facfe,#00f2fe);">
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <div class="col-md-4 text-center">
                                    <img src="@Model.CurrentWeather.Icon" style="width:80px;">
                                    <h2 class="display-4 fw-bold mb-0">@Model.CurrentWeather.Temperature.ToString("0")°C</h2>
                                    <p class="fs-5">@Model.CurrentWeather.Condition</p>
                                </div>
                                <div class="col-md-4">
                                    <p><i class="fas fa-thermometer-half me-2"></i>Feels Like: @Model.CurrentWeather.FeelsLike.ToString("0")°C</p>
                                    <p><i class="fas fa-tint me-2"></i>Humidity: @Model.CurrentWeather.Humidity%</p>
                                    <p><i class="fas fa-wind me-2"></i>Wind: @Model.CurrentWeather.WindSpeed km/h</p>
                                </div>
                                <div class="col-md-4">
                                    <p><i class="fas fa-arrow-up me-2"></i>Max: @Model.CurrentWeather.TempMax.ToString("0")°C</p>
                                    <p><i class="fas fa-arrow-down me-2"></i>Min: @Model.CurrentWeather.TempMin.ToString("0")°C</p>
                                    <p><i class="fas fa-compress-arrows-alt me-2"></i>Pressure: @Model.CurrentWeather.Pressure hPa</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Forecast?.DailyForecasts != null && Model.Forecast.DailyForecasts.Any())
                    {
                        <h4 class="fw-bold mb-3">5-Day Forecast</h4>
                        <div class="row g-3">
                            @foreach (var day in Model.Forecast.DailyForecasts.Take(5))
                            {
                                <div class="col">
                                    <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                                        <h6 class="fw-bold">@day.Date.ToString("ddd")</h6>
                                        <small class="text-muted">@day.Date.ToString("dd MMM")</small>
                                        <img src="@day.Icon" style="width:45px;" class="mx-auto my-2">
                                        <h5 class="mb-0 text-primary">@day.TempMax.ToString("0")°</h5>
                                        <small class="text-muted">@day.TempMin.ToString("0")°</small>
                                        <p class="small mt-2 mb-0">@day.Condition</p>
                                        <small class="text-muted"><i class="fas fa-tint me-1"></i>@day.Humidity%</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning">Weather data not available</div>
                }
            </div>

            <!-- ========================================================= -->
            <!-- STEP 2: TRANSPORT TAB -->
            <!-- ========================================================= -->
            <div class="tab-pane fade" id="transport">
                <h3 class="fw-bold mb-4"><i class="fas fa-bus text-primary me-2"></i>Step 2: Select Transport (Required)</h3>

                @if (Model.Transports.Any())
                {
                    <div class="row g-3" id="transportList">
                        @foreach (var t in Model.Transports)
                        {
                            <div class="col-md-6 transport-item" data-type="@t.transport_type">
                                <div class="card border-0 shadow-sm rounded-4">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <span class="badge @(t.transport_type == "Flight" ? "bg-info" : t.transport_type == "Train" ? "bg-success" : "bg-warning text-dark") mb-2">
                                                    <i class="fas @(t.transport_type == "Flight" ? "fa-plane" : t.transport_type == "Train" ? "fa-train" : "fa-bus") me-1"></i> @t.transport_type
                                                </span>
                                                <h6 class="fw-bold mb-1">@t.company_name</h6>
                                                <p class="text-muted small mb-1"><i class="fas fa-route me-1"></i>@t.departure_city → @t.arrival_city</p>
                                                <p class="text-muted small mb-1"><i class="fas fa-clock me-1"></i>Departs: @t.departure_time | Duration: @t.duration</p>
                                            </div>
                                            <div class="text-end">
                                                <h5 class="text-primary fw-bold mb-1">PKR @t.fare?.ToString("N0")<span class="text-muted fw-normal fs-6">/seat</span></h5>
                                                <small class="text-success"><i class="fas fa-chair me-1"></i>@t.available_seats seats</small>
                                            </div>
                                        </div>
                                        <button class="btn btn-outline-primary btn-sm w-100 mt-2" onclick="selectTransport(@t.transport_id, '@t.company_name', @t.fare, '@t.transport_type', @t.available_seats)">
                                            Select This Transport
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">No transport options found for @Model.CityName.</div>
                }
            </div>

            <!-- ========================================================= -->
            <!-- MAP TAB -->
            <!-- ========================================================= -->
            <div class="tab-pane fade" id="map">
                <h3 class="fw-bold mb-4"><i class="fas fa-map text-primary me-2"></i>Location Map</h3>
                <div id="mainMap" style="height:400px; border-radius:16px;"></div>
            </div>

            <!-- ========================================================= -->
            <!-- REVIEWS TAB -->
            <!-- ========================================================= -->
            <div class="tab-pane fade" id="reviews">
                <h3 class="fw-bold mb-4"><i class="fas fa-star text-primary me-2"></i>Reviews (@Model.TotalReviews)</h3>
                @if (userId.HasValue)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3">Write a Review</h5>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Rating</label>
                                <div id="starRating" class="d-flex gap-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star fa-2x" data-rating="@i" style="cursor:pointer; color:#ddd;" onclick="setRating(@i)"></i>
                                    }
                                </div>
                                <input type="hidden" id="selectedRating" value="0">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Your Review</label>
                                <textarea id="reviewComment" class="form-control" rows="3" placeholder="Share your experience..."></textarea>
                            </div>
                            <button class="btn btn-primary" onclick="submitReview('@Model.CityName')"><i class="fas fa-paper-plane me-2"></i>Submit Review</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-4"><a href="@Url.Action("Login", "Account")" class="fw-bold">Login</a> to write a review</div>
                }
                @foreach (var review in Model.Reviews.Take(5))
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-3">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary rounded-circle text-white d-flex align-items-center justify-content-center" style="width:40px; height:40px;">@(review.User?.full_name?.FirstOrDefault() ?? 'U')</div>
                                    <div><h6 class="mb-0 fw-bold">@(review.User?.full_name ?? "Anonymous")</h6><small class="text-muted">@review.created_at.ToString("dd MMM yyyy")</small></div>
                                </div>
                                <div>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= (review.rating ?? 0) ? "text-warning" : "text-muted") small"></i>
                                    }
                                </div>
                            </div>
                            <p class="mt-3 mb-0">@review.comment</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- STEP 3: DETAILED BOOKING MODAL -->
<div class="modal fade" id="bookingModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header" style="background:linear-gradient(135deg,#667eea,#764ba2);">
                <h5 class="modal-title text-white fw-bold"><i class="fas fa-clipboard-list me-2"></i>Step 3: Confirm Your Booking</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">

                <!-- Hotel Section -->
                <div class="card border-0 bg-light rounded-4 mb-4">
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-3"><i class="fas fa-hotel text-primary me-2"></i>Hotel Details</h6>
                        <div id="hotelDetailsSection">
                            <p class="text-muted mb-0">No hotel selected</p>
                        </div>
                        <div id="hotelDatesSection" style="display:none;" class="mt-2">
                            <div class="row g-2">
                                <div class="col-md-5">
                                    <label class="form-label small fw-bold">Check In Date</label>
                                    <input type="date" id="hotelCheckIn" class="form-control form-control-sm" onchange="updateHotelNights()">
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label small fw-bold">Check Out Date</label>
                                    <input type="date" id="hotelCheckOut" class="form-control form-control-sm" onchange="updateHotelNights()">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold">Nights</label>
                                    <input type="text" id="hotelNights" class="form-control form-control-sm" readonly value="0">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Transport Section -->
                <div class="card border-0 bg-light rounded-4 mb-4">
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-3"><i class="fas fa-bus text-primary me-2"></i>Transport Details</h6>
                        <div id="transportDetailsSection">
                            <p class="text-muted mb-0">No transport selected</p>
                        </div>
                        <div id="transportSeatsSection" style="display:none;" class="mt-2">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Travel Date</label>
                                    <input type="date" id="travelDate" class="form-control form-control-sm" onchange="updateTransportTotal()">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Number of Seats</label>
                                    <input type="number" id="transportSeats" class="form-control form-control-sm" value="1" min="1" max="10" onchange="updateTransportTotal()">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Price Breakdown -->
                <div class="card border-primary rounded-4">
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-3 text-primary"><i class="fas fa-calculator me-2"></i>Price Breakdown</h6>
                        <div class="d-flex justify-content-between mb-2">
                            <span id="hotelCostLabel">Hotel</span>
                            <span id="hotelCostValue">PKR 0</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span id="transportCostLabel">Transport</span>
                            <span id="transportCostValue">PKR 0</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Grand Total</span>
                            <span class="text-primary" id="grandTotalValue">PKR 0</span>
                        </div>
                    </div>
                </div>

                <!-- Hidden Fields -->
                <input type="hidden" id="selectedHotelName" value="">
                <input type="hidden" id="selectedHotelPrice" value="0">
                <input type="hidden" id="selectedTransportId" value="">
                <input type="hidden" id="selectedTransportFare" value="0">
                <input type="hidden" id="selectedTransportName" value="">
                <input type="hidden" id="isHotelSkipped" value="false">

                <!-- Guest Details -->
                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Guest Name</label>
                        <input type="text" id="guestName" class="form-control" value="@userName" placeholder="Full name">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Contact Number</label>
                        <input type="text" id="guestPhone" class="form-control" placeholder="03XXXXXXXXX">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" onclick="finalConfirmBooking()"><i class="fas fa-check-circle me-2"></i>Confirm Booking</button>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 text-center">
            <div class="modal-body p-5">
                <i class="fas fa-check-circle fa-5x text-success mb-3"></i>
                <h3 class="fw-bold">Booking Confirmed!</h3>
                <p class="text-muted">Your booking reference is:</p>
                <h4 class="text-primary fw-bold" id="bookingRef"></h4>
                <a href="@Url.Action("MyBookings", "Bookings")" class="btn btn-primary mt-3">View My Bookings</a>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script>
        // =========================================================
        // FIX 1: Fix Leaflet marker icon (GitHub issue)
        // =========================================================
        var LeafIcon = L.Icon.extend({
        options: {
        iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png',
        iconRetinaUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon-2x.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
        }
        });
        var redIcon = new LeafIcon();

        // =========================================================
        // FIX 2: Map initialization with marker
        // =========================================================
        var map = null;
        var marker = null;

        function initMap() {
        if (map == null) {
        @if (Model.DestinationInfo != null && Model.DestinationInfo.Lat != 0)
        {
            <text>
                var lat = @Model.DestinationInfo.Lat.ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture);
                var lon = @Model.DestinationInfo.Lon.ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture);

                map = L.map('mainMap').setView([lat, lon], 12);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
                }).addTo(map);

                marker = L.marker([lat, lon], { icon: redIcon })
                .addTo(map)
                .bindPopup('<b>@Model.CityName</b><br>Pakistan')
                .openPopup();
            </text>
        }
        else
        {
            <text>
                var lat = 30.3753;
                var lon = 69.3451;
                map = L.map('mainMap').setView([lat, lon], 6);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
                }).addTo(map);
                marker = L.marker([lat, lon], { icon: redIcon })
                .addTo(map)
                .bindPopup('Pakistan')
                .openPopup();
            </text>
        }
        setTimeout(function() { map.invalidateSize(); }, 200);
        }
        }

        // Map tab click pe initialize karo
        document.querySelector('[data-bs-target="#map"]').addEventListener('shown.bs.tab', function() {
        initMap();
        });

        // =========================================================
        // Star Rating
        // =========================================================
        function setRating(rating) {
        document.getElementById('selectedRating').value = rating;
        document.querySelectorAll('#starRating i').forEach(function(star, idx) {
        star.style.color = idx < rating ? '#ffc107' : '#ddd';
        });
        }

        function submitReview(destName) {
        var rating = document.getElementById('selectedRating').value;
        var comment = document.getElementById('reviewComment').value;
        if (rating == 0) { alert('Please select a rating'); return; }
        if (!comment.trim()) { alert('Please write a review'); return; }
        fetch('@Url.Action("AddReview", "Destinations")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `destinationName=${encodeURIComponent(destName)}&rating=${rating}&comment=${encodeURIComponent(comment)}`
        }).then(r => r.json()).then(data => { if (data.success) location.reload(); else alert(data.message); });
        }

        // =========================================================
        // STEP 1: HOTEL SELECTION
        // =========================================================
        var selectedHotel = { name: '', pricePerNight: 0, nights: 0, checkIn: '', checkOut: '' };
        var selectedTransport = { id: '', name: '', farePerSeat: 0, seats: 1, travelDate: '' };
        var isHotelSkipped = false;

        function selectHotel(name, pricePerNight) {
        selectedHotel.name = name;
        selectedHotel.pricePerNight = pricePerNight;
        isHotelSkipped = false;
        document.getElementById('selectedHotelName').value = name;
        document.getElementById('selectedHotelPrice').value = pricePerNight;
        document.getElementById('isHotelSkipped').value = 'false';

        document.getElementById('hotelDetailsSection').innerHTML = `<p class="fw-bold mb-0">${name}</p><small class="text-muted">PKR ${pricePerNight.toLocaleString()} / night</small>`;
        document.getElementById('hotelDatesSection').style.display = 'block';

        var tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        var dayAfter = new Date();
        dayAfter.setDate(dayAfter.getDate() + 2);
        document.getElementById('hotelCheckIn').value = tomorrow.toISOString().split('T')[0];
        document.getElementById('hotelCheckOut').value = dayAfter.toISOString().split('T')[0];
        updateHotelNights();
        switchToTransportTab();
        }

        function skipHotels() {
        selectedHotel.name = 'No Hotel';
        selectedHotel.pricePerNight = 0;
        selectedHotel.nights = 0;
        isHotelSkipped = true;
        document.getElementById('selectedHotelName').value = '';
        document.getElementById('selectedHotelPrice').value = '0';
        document.getElementById('isHotelSkipped').value = 'true';
        document.getElementById('hotelDetailsSection').innerHTML = `<p class="text-muted mb-0">No hotel selected (skipped)</p>`;
        document.getElementById('hotelDatesSection').style.display = 'none';
        updateHotelCost();
        switchToTransportTab();
        }

        function updateHotelNights() {
        var checkIn = new Date(document.getElementById('hotelCheckIn').value);
        var checkOut = new Date(document.getElementById('hotelCheckOut').value);
        if (checkIn && checkOut && checkOut > checkIn) {
        var nights = Math.ceil((checkOut - checkIn) / (1000 * 60 * 60 * 24));
        selectedHotel.nights = nights;
        selectedHotel.checkIn = document.getElementById('hotelCheckIn').value;
        selectedHotel.checkOut = document.getElementById('hotelCheckOut').value;
        document.getElementById('hotelNights').value = nights;
        updateHotelCost();
        }
        }

        function updateHotelCost() {
        var hotelTotal = selectedHotel.pricePerNight * selectedHotel.nights;
        document.getElementById('hotelCostLabel').innerHTML = `Hotel (${selectedHotel.nights} nights)`;
        document.getElementById('hotelCostValue').innerHTML = `PKR ${hotelTotal.toLocaleString()}`;
        updateGrandTotal();
        }

        function switchToTransportTab() {
        var transportTab = document.querySelector('[data-bs-target="#transport"]');
        var transportTabPane = document.getElementById('transport');
        document.querySelectorAll('.nav-link').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('show', 'active'));
        transportTab.classList.add('active');
        transportTabPane.classList.add('show', 'active');
        transportTabPane.scrollIntoView({ behavior: 'smooth' });
        }

        // =========================================================
        // STEP 2: TRANSPORT SELECTION
        // =========================================================
        function selectTransport(id, name, farePerSeat, type, availableSeats) {
        selectedTransport.id = id;
        selectedTransport.name = `${name} (${type})`;
        selectedTransport.farePerSeat = farePerSeat;
        document.getElementById('selectedTransportId').value = id;
        document.getElementById('selectedTransportFare').value = farePerSeat;
        document.getElementById('selectedTransportName').value = name;

        document.getElementById('transportDetailsSection').innerHTML = `<p class="fw-bold mb-0">${selectedTransport.name}</p><small class="text-muted">PKR ${farePerSeat.toLocaleString()} / seat</small>`;
        document.getElementById('transportSeatsSection').style.display = 'block';

        var tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        document.getElementById('travelDate').value = tomorrow.toISOString().split('T')[0];
        document.getElementById('transportSeats').max = availableSeats;
        updateTransportTotal();

        var bookingModal = new bootstrap.Modal(document.getElementById('bookingModal'));
        bookingModal.show();
        }

        function updateTransportTotal() {
        var seats = parseInt(document.getElementById('transportSeats').value) || 1;
        var travelDate = document.getElementById('travelDate').value;
        selectedTransport.seats = seats;
        selectedTransport.travelDate = travelDate;
        var transportTotal = selectedTransport.farePerSeat * seats;
        document.getElementById('transportCostLabel').innerHTML = `Transport (${seats} seat${seats > 1 ? 's' : ''})`;
        document.getElementById('transportCostValue').innerHTML = `PKR ${transportTotal.toLocaleString()}`;
        updateGrandTotal();
        }

        function updateGrandTotal() {
        var hotelTotal = selectedHotel.pricePerNight * selectedHotel.nights;
        var transportTotal = selectedTransport.farePerSeat * selectedTransport.seats;
        var grandTotal = hotelTotal + transportTotal;
        document.getElementById('grandTotalValue').innerHTML = `PKR ${grandTotal.toLocaleString()}`;
        }

        // =========================================================
        // STEP 3: FINAL CONFIRMATION
        // =========================================================
        function finalConfirmBooking() {
        var guestName = document.getElementById('guestName').value;
        var guestPhone = document.getElementById('guestPhone').value;

        if (!guestName) { alert('Please enter guest name'); return; }
        if (!guestPhone) { alert('Please enter contact number'); return; }
        if (!selectedTransport.id) { alert('Please select transport first'); return; }
        if (selectedTransport.seats < 1) { alert('Please select at least 1 seat'); return; }

        var hotelTotal = selectedHotel.pricePerNight * selectedHotel.nights;
        var transportTotal = selectedTransport.farePerSeat * selectedTransport.seats;
        var grandTotal = hotelTotal + transportTotal;

        var requestBody = `destinationName=@Model.CityName` +
        `&hotelName=${encodeURIComponent(isHotelSkipped ? '' : selectedHotel.name)}` +
        `&hotelPricePerNight=${selectedHotel.pricePerNight}` +
        `&transportId=${selectedTransport.id}` +
        `&checkIn=${selectedHotel.checkIn || ''}` +
        `&checkOut=${selectedHotel.checkOut || ''}` +
        `&guests=${selectedTransport.seats}` +
        `&totalPrice=${grandTotal}`;

        fetch('@Url.Action("CreateBooking", "Destinations")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: requestBody
        })
        .then(r => r.json())
        .then(data => {
        if (data.success) {
        bootstrap.Modal.getInstance(document.getElementById('bookingModal')).hide();
        document.getElementById('bookingRef').textContent = data.reference;
        new bootstrap.Modal(document.getElementById('successModal')).show();
        } else {
        alert(data.message || 'Booking failed');
        }
        })
        .catch(error => {
        console.error('Error:', error);
        alert('An error occurred. Please try again.');
        });
        }
    </script>
}

