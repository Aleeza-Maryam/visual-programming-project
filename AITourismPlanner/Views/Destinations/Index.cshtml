@model List<AITourismPlanner.Services.DestinationInfo>
@{
    ViewData["Title"] = "Explore Pakistan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">

    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">
            <i class="fas fa-map-marked-alt text-primary me-2"></i>
            Explore Pakistan
        </h1>
        <p class="lead text-muted">
            Discover amazing tourist destinations across Pakistan
        </p>
    </div>

    <!-- Search Bar -->
    <div class="card shadow-sm border-0 rounded-4 mb-5">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-10">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" name="searchTerm"
                               class="form-control border-start-0"
                               placeholder="Search destinations e.g. Hunza, Lahore, Swat..."
                               value="@ViewBag.SearchTerm">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Results -->
    @if (Model != null && Model.Any())
    {
        <div class="mb-4 d-flex justify-content-between align-items-center">
            <p class="text-muted mb-0">
                Showing <strong>@Model.Count</strong> destinations
            </p>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-times me-1"></i> Clear Search
                </a>
            }
        </div>

        <div class="row g-4">
            @foreach (var dest in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card destination-card h-100 shadow-sm border-0 rounded-4 overflow-hidden">

                        <!-- Image -->
                        <div class="position-relative">
                            <img src="@dest.ImageUrl"
                                 class="card-img-top"
                                 style="height:200px; object-fit:cover;"
                                 alt="@dest.Name"
                                 onerror="this.src='https://images.unsplash.com/photo-1586500036706-41963de24d8b?w=600'">

                            <div class="position-absolute top-0 start-0 m-2">
                                <span class="badge"
                                      style="background:rgba(0,0,0,0.5);">
                                    <i class="fas fa-map-marker-alt me-1"></i>
                                    Pakistan
                                </span>
                            </div>
                        </div>

                        <!-- Body -->
                        <div class="card-body p-3">
                            <h5 class="card-title fw-bold mb-1">@dest.Name</h5>
                            <p class="text-muted small mb-0"
                               style="display:-webkit-box;
                                      -webkit-line-clamp:2;
                                      -webkit-box-orient:vertical;
                                      overflow:hidden;">
                                @dest.Description
                            </p>
                        </div>

                        <!-- Footer -->
                        <div class="card-footer bg-transparent border-0 pb-3 px-3">
                            <a href="@Url.Action("ApiDetails", "Destinations",
                                new { cityName = dest.Name })"
                               class="btn btn-primary w-100 btn-sm">
                                Explore
                                <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-map-marked-alt fa-4x text-muted mb-3"></i>
            <h3>No destinations found</h3>
            <p class="text-muted">Try a different search term</p>
            <a href="@Url.Action("Index")" class="btn btn-primary mt-2">
                Show All Destinations
            </a>
        </div>
    }
</div>

<style>
    .destination-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }
    .destination-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.15) !important;
    }
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102,126,234,0.4);
    }
</style>