@model List<AITourismPlanner.ViewModels.CombinedBooking>
@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h1 class="display-5 fw-bold mb-4">
        <i class="fas fa-ticket-alt text-primary me-2"></i>My Bookings
    </h1>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var booking in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <!-- Booking Type Badge -->
                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        <span class="badge @(booking.BookingType == "Package" ? "bg-info" : "bg-primary") fs-6 px-3 py-2">
                                            @if (booking.BookingType == "Package")
                                            {
                                                <i class="fas fa-box me-1"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-hotel me-1"></i>
                                            }
                                            @booking.BookingType
                                        </span>
                                        <span class="badge @(booking.BookingStatus == "Confirmed" ? "bg-success" : booking.BookingStatus == "Cancelled" ? "bg-danger" : "bg-warning") fs-6 px-3 py-2">
                                            @booking.BookingStatus
                                        </span>
                                        <span class="text-muted small">
                                            Ref: <strong>@booking.BookingReference</strong>
                                        </span>
                                    </div>

                                    <!-- Package or Destination Name -->
                                    @if (booking.BookingType == "Package")
                                    {
                                        <h4 class="fw-bold mb-2">
                                            <i class="fas fa-box text-primary me-2"></i>
                                            @booking.PackageName
                                        </h4>
                                        <p class="text-muted mb-2">
                                            <i class="fas fa-map-marker-alt me-1"></i> @booking.DestinationName
                                        </p>
                                    }
                                    else
                                    {
                                        <h4 class="fw-bold mb-2">
                                            <i class="fas fa-map-marker-alt text-primary me-2"></i>
                                            @booking.DestinationName
                                        </h4>
                                    }

                                    <!-- Booking Details -->
                                    <div class="row g-2 text-muted small mt-2">
                                        @if (booking.BookingType == "Package")
                                        {
                                            <div class="col-6">
                                                <i class="fas fa-calendar me-1"></i>
                                                Travel Date: @booking.TravelDate.ToString("dd MMM yyyy")
                                            </div>
                                            <div class="col-6">
                                                <i class="fas fa-clock me-1"></i>
                                                Duration: @((booking.CheckOutDate - booking.CheckInDate).Days) Days
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-6">
                                                <i class="fas fa-hotel me-1"></i>
                                                @(booking.HotelName ?? "No hotel selected")
                                            </div>
                                            <div class="col-6">
                                                <i class="fas fa-bus me-1"></i>
                                                @(booking.TransportName ?? "No transport selected")
                                            </div>
                                            <div class="col-6">
                                                <i class="fas fa-calendar-check me-1"></i>
                                                @booking.CheckInDate.ToString("dd MMM yyyy") - @booking.CheckOutDate.ToString("dd MMM yyyy")
                                            </div>
                                        }
                                        <div class="col-6">
                                            <i class="fas fa-users me-1"></i>
                                            @booking.NumberOfGuests guests
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4 text-end">
                                    <h3 class="text-primary fw-bold mb-2">
                                        PKR @booking.TotalPrice.ToString("N0")
                                    </h3>
                                    <span class="badge @(booking.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark") mb-3">
                                        Payment: @booking.PaymentStatus
                                    </span>
                                    <br>
                                    @if (booking.BookingStatus == "Confirmed")
                                    {
                                        <button class="btn btn-outline-danger btn-sm" onclick="cancelBooking(@booking.BookingId, '@booking.BookingType')">
                                            <i class="fas fa-times me-1"></i>Cancel
                                        </button>
                                    }
                                    @if (booking.BookingType == "Package")
                                    {
                                        <a href="@Url.Action("DownloadVoucher", "Packages", new { reference = booking.BookingReference })" class="btn btn-outline-success btn-sm mt-2" target="_blank">
                                            <i class="fas fa-download me-1"></i>Download Voucher
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-ticket-alt fa-4x text-muted mb-3"></i>
            <h3>No Bookings Yet</h3>
            <p class="text-muted">Start exploring destinations and make your first booking!</p>
            <div class="d-flex gap-3 justify-content-center mt-3">
                <a href="@Url.Action("Index", "Destinations")" class="btn btn-primary">
                    <i class="fas fa-search me-2"></i>Explore Destinations
                </a>
                <a href="@Url.Action("Index", "Packages")" class="btn btn-outline-primary">
                    <i class="fas fa-box me-2"></i>View Packages
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function cancelBooking(id, type) {
            if (!confirm('Are you sure? Cancellations within 24 hours are not allowed.'))
                return;

            var url = type === 'Package'
                ? '@Url.Action("CancelPackageBooking", "Packages")'
                : '@Url.Action("Cancel", "Bookings")';

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${id}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) location.reload();
                else alert(data.message || 'Cannot cancel this booking');
            });
        }
    </script>
}