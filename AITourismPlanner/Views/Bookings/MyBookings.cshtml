@model List<AITourismPlanner.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h1 class="display-5 fw-bold mb-4">
        <i class="fas fa-ticket-alt text-primary me-2"></i>My Bookings
    </h1>

    @if (Model.Any())
    {
        @foreach (var booking in Model)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <span class="badge @(booking.booking_status == "Confirmed"
                                                                          ? "bg-success" : booking.booking_status == "Cancelled"
                                                                          ? "bg-danger" : "bg-warning") fs-6 px-3 py-2">
                                    @booking.booking_status
                                </span>
                                <span class="text-muted small">
                                    Ref: <strong>@booking.booking_reference</strong>
                                </span>
                            </div>
                            <h4 class="fw-bold mb-2">
                                <i class="fas fa-map-marker-alt text-primary me-2"></i>
                                @booking.destination_name
                            </h4>
                            <div class="row g-2 text-muted small">
                                <div class="col-6">
                                    <i class="fas fa-hotel me-1"></i>
                                    @(booking.hotel_name ?? "No hotel")
                                </div>
                                <div class="col-6">
                                    <i class="fas fa-calendar-check me-1"></i>
                                    @booking.check_in_date.ToString("dd MMM yyyy") -
                                    @booking.check_out_date.ToString("dd MMM yyyy")
                                </div>
                                <div class="col-6">
                                    <i class="fas fa-users me-1"></i>
                                    @booking.number_of_guests guests
                                </div>
                                <div class="col-6">
                                    <i class="fas @(booking.Transport?.transport_type == "Flight"
                                                                               ? "fa-plane" : booking.Transport?.transport_type == "Train"
                                                                               ? "fa-train" : "fa-bus") me-1"></i>
                                    @(booking.Transport?.company_name ?? "No transport")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <h3 class="text-primary fw-bold mb-2">
                                PKR @booking.total_price?.ToString("N0")
                            </h3>
                            <span class="badge @(booking.payment_status == "Paid"
                                                                  ? "bg-success" : "bg-warning text-dark") mb-3">
                                Payment: @booking.payment_status
                            </span>
                            <br>
                            @if (booking.booking_status == "Confirmed")
                            {
                                <button class="btn btn-outline-danger btn-sm"
                                        onclick="cancelBooking(@booking.booking_id)">
                                    <i class="fas fa-times me-1"></i>Cancel
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-ticket-alt fa-4x text-muted mb-3"></i>
            <h3>No Bookings Yet</h3>
            <p class="text-muted">Start exploring destinations and make your first booking!</p>
            <a href="@Url.Action("Index", "Destinations")"
               class="btn btn-primary mt-2">
                Explore Destinations
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function cancelBooking(id) {
            if (!confirm('Are you sure? Cancellations within 24 hours are not allowed.'))
                return;

            fetch('@Url.Action("Cancel", "Bookings")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${id}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) location.reload();
                else alert(data.message || 'Cannot cancel this booking');
            });
        }
    </script>
}